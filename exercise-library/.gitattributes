# Git LFS tracking for exercise media (Phase B4). Declarative only — run
# `git lfs install` once on this machine before the first commit that
# touches files matched here. See README.md for the full procedure.
media/**/*.gif filter=lfs diff=lfs merge=lfs -text
media/**/*.png filter=lfs diff=lfs merge=lfs -text
media/**/*.jpg filter=lfs diff=lfs merge=lfs -text
media/**/*.jpeg filter=lfs diff=lfs merge=lfs -text
media/**/*.webp filter=lfs diff=lfs merge=lfs -text
versions/**/media/**/*.gif filter=lfs diff=lfs merge=lfs -text
versions/**/media/**/*.png filter=lfs diff=lfs merge=lfs -text
versions/**/media/**/*.jpg filter=lfs diff=lfs merge=lfs -text
versions/**/media/**/*.webp filter=lfs diff=lfs merge=lfs -text
