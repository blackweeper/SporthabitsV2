# Copier en .env pour un lancement local (jamais committé — voir .gitignore).

# Chaîne de connexion MongoDB. En local : mongodb://localhost:27017
# En production (Render) : chaîne de connexion MongoDB Atlas, voir README.md §1.
MONGO_URL=mongodb://localhost:27017

# Nom de la base à utiliser.
DB_NAME=ironflow

# Token secret partagé attendu dans le header "Authorization: Bearer <token>"
# de l'endpoint /api/health-import. Générer une vraie valeur avec :
#   openssl rand -hex 32
HEALTH_IMPORT_TOKEN=change-me
