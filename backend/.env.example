# Copier en .env pour un lancement local (jamais committé — voir .gitignore).

# Chaîne de connexion MongoDB. En local : mongodb://localhost:27017
# En production (Render) : chaîne de connexion MongoDB Atlas, voir README.md §1.
MONGO_URL=mongodb://localhost:27017

# Nom de la base à utiliser.
DB_NAME=ironflow

# Token secret partagé attendu dans le header "Authorization: Bearer <token>"
# de l'endpoint /api/health-import. Générer une vraie valeur avec :
#   openssl rand -hex 32
HEALTH_IMPORT_TOKEN=change-me

# ========== IA pour analyse de programmes PDF ==========

# Provider à utiliser : "nvidia" ou "groq". Défaut : nvidia.
AI_PROVIDER=groq

# ---------- Groq (https://console.groq.com) ----------
# Inférence très rapide, palier gratuit sans carte bancaire — recommandé
# pour un usage personnel peu fréquent (voir AI_PDF_IMPORT_README.md).

# Clé API Groq (console.groq.com/keys, commence par "gsk_")
# JAMAIS committée, JAMAIS exposée au frontend, JAMAIS loggée.
GROQ_API_KEY=gsk_xxxxx

# Base URL de l'API Groq (OpenAI-compatible)
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Modèle par défaut (configurable sans modifier le code)
GROQ_MODEL=openai/gpt-oss-120b

# Timeout en secondes pour les appels IA
GROQ_TIMEOUT=120

# ---------- NVIDIA NIM (https://build.nvidia.com/explore/discover) ----------
# Alternative à Groq — utilisée seulement si AI_PROVIDER=nvidia.

# Clé API NVIDIA. JAMAIS committée, JAMAIS exposée au frontend, JAMAIS loggée.
NVIDIA_API_KEY=nvapi-xxxxx

# Base URL de l'API NVIDIA NIM
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# Modèle par défaut (configurable sans modifier le code)
# Modèles texte : meta/llama-3.1-405b-instruct, meta/llama-3.1-70b-instruct
# Modèles vision : nvidia/neva-22b (si disponible avec votre clé)
NVIDIA_MODEL=meta/llama-3.1-405b-instruct

# Timeout en secondes pour les appels IA
NVIDIA_TIMEOUT=120
