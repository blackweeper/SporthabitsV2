{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "frontend-dist-prod",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["http-server", "frontend/dist"],
      "port": 8099,
      "autoPort": true
    },
    {
      "name": "frontend-web-dev",
      "runtimeExecutable": "node",
      "runtimeArgs": ["frontend/node_modules/expo/bin/cli", "start", "frontend", "--web", "--port", "8081"],
      "port": 8081,
      "autoPort": true
    }
  ]
}
